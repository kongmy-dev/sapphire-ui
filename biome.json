{
  "$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!dist",
      "!dist-docs",
      "!coverage",
      "!design",
      "!public",
      "!tests/registry-consumer/app/components",
      "!tests/registry-consumer/app/styles",
      "!tests/registry-consumer/dist"
    ]
  },
  "plugins": [
    {
      "path": "./tooling/biome/no-cast.grit",
      "includes": [
        "**",
        "!**/src/**",
        "!**/registry/blocks/**",
        "!**/tests/registry-consumer/app/**"
      ]
    }
  ],
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "nursery": {
        "useSortedClasses": {
          "level": "warn",
          "options": {
            "functions": ["clsx", "cva", "cn"],
            "attributes": ["className", "class"]
          }
        }
      },
      "a11y": {
        "noNoninteractiveElementToInteractiveRole": "off",
        "noStaticElementInteractions": "off",
        "useButtonType": "off",
        "useFocusableInteractive": "off",
        "useKeyWithClickEvents": "off",
        "useSemanticElements": "off",
        "useValidAnchor": "off",
        "noLabelWithoutControl": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "suspicious": {
        "noArrayIndexKey": "off",
        "noExplicitAny": "error",
        "noConsole": "error",
        "noFocusedTests": "error",
        "noSkippedTests": "error"
      },
      "complexity": {
        "noImportantStyles": "off"
      },
      "style": {
        "noDescendingSpecificity": "off",
        "noNonNullAssertion": "error",
        "noEnum": "error",
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        },
        "noNestedTernary": "error",
        "noUselessElse": "error",
        "noParameterAssign": "error"
      }
    }
  },
  "css": {
    "parser": { "tailwindDirectives": true },
    "formatter": { "enabled": true },
    "linter": { "enabled": true }
  },
  "overrides": [
    {
      "includes": ["registry/blocks/**"],
      "linter": {
        "rules": {
          "correctness": { "useExhaustiveDependencies": "off" },
          "nursery": { "useSortedClasses": "off" }
        }
      }
    },
    {
      "includes": ["src/components/*Element.ts", "src/elements.ts"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noAssignInExpressions": "off",
            "useIterableCallbackReturn": "off",
            "noImplicitAnyLet": "off",
            "noDoubleEquals": "off"
          },
          "correctness": {
            "noUnusedVariables": "off",
            "noInnerDeclarations": "off"
          },
          "complexity": {
            "noArguments": "off",
            "noCommaOperator": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/components/Toast.tsx",
        "src/components/ui/Dialog.tsx",
        "src/components/ui/PageSection.tsx",
        "src/components/ui/SEOHead.tsx",
        "src/components/ui/SiteFooter.tsx",
        "src/components/ui/SiteHeader.tsx",
        "src/pages/**",
        "src/lib/consent.ts"
      ],
      "linter": {
        "rules": {
          "suspicious": { "noExplicitAny": "off" },
          "correctness": { "noUnusedVariables": "off" }
        }
      }
    },
    {
      "includes": ["components/**/*.examples.html"],
      "linter": {
        "rules": {
          "a11y": { "noNoninteractiveTabindex": "off" }
        }
      }
    },
    {
      "includes": ["scripts/**", "tooling/**", "tests/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "off" }
        }
      }
    },
    {
      "includes": ["src/**", "registry/blocks/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noExplicitAny": "off",
            "noConsole": "off",
            "noFocusedTests": "off",
            "noSkippedTests": "off",
            "noDocumentCookie": "info"
          },
          "style": {
            "noNonNullAssertion": "off",
            "noEnum": "off",
            "useConsistentTypeDefinitions": "off",
            "noNestedTernary": "off",
            "noUselessElse": "off",
            "noParameterAssign": "off"
          }
        }
      }
    },
    {
      "includes": ["src/**"],
      "linter": {
        "rules": {
          "style": { "useTemplate": "info" },
          "complexity": {
            "useOptionalChain": "info",
            "noBannedTypes": "info",
            "noUselessConstructor": "info"
          },
          "nursery": { "useSortedClasses": "info" }
        }
      }
    }
  ]
}
