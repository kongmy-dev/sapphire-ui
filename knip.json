{
  "$schema": "./node_modules/knip/schema.json",
  "entry": [
    "tooling/quality-metrics/metrics.ts",
    "css/tailwind.css",
    "sapphire.css",
    "site/*.css",
    "css/*.examples.css",
    "components/*/*.examples.css",
    "playwright.visual.config.ts",
    "tests/visual/*.spec.ts",
    "components/*/*.examples.tsx",
    "tooling/testing/*.ts",
    "tooling/examples/browser.tsx",
    "elements/*.examples.ts",
    "tooling/examples/element-browser.ts",
    "tooling/examples/equivalence.tsx",
    "site/client.ts",
    "blocks/*/*.tsx",
    "blocks/*/*.css"
  ],
  "project": ["**/*.{ts,tsx,css}"],
  "ignoreDependencies": ["^@fontsource-variable/", "shadcn", "tailwindcss"]
}
