    "typecheck": "tsc -b",
    "knip": "knip",
    "prepare": "git config core.hooksPath .githooks || true",
    "lint": "biome check --error-on-warnings",
    "lint:fix": "biome check --write",
    "format": "biome check --write",
    "build:docs": "bun tooling/site/build.ts dist-docs --registry",
    "build:registry": "bun tooling/registry/build.ts",
    "check:registry": "bun run build:registry && bun tooling/registry/check.ts",
    "preview": "bun tooling/site/serve.ts dist-docs 4173",
    "test:a11y": "playwright test && bun run a11y-coverage-check",
    "test": "bun test --coverage --coverage-reporter=lcov",
    "test:registry": "bun tooling/registry/smoke.ts",
    "smoke:registry": "bun tooling/registry/smoke.ts",
    "comment-check": "bun tooling/gates/comments.ts",
    "size-check": "bun tooling/gates/size.ts",
    "token-check": "bun tooling/gates/tokens.ts",
    "budget-check": "bun tooling/gates/budget.ts",
    "generated-check": "bun tooling/gates/generated.ts",
    "generate": "bun tooling/generate.ts",
    "dep-check": "bun tooling/gates/deps.ts",
    "scorecard": "bun tooling/scorecard/run.ts",
    "test:visual": "bun tooling/visual/test.ts",
    "pin": "bun tooling/visual/pin.ts",
    "gate": "bun run lint && bun run typecheck && bun run knip && bun run comment-check && bun run size-check && bun run dep-check && bun run token-check && bun run budget-check && bun run generated-check && bun run api-check && bun run boundary-check && bun run contract-check && bun run docs-check && bun run skill-refs-check && bun run test && bun run coverage-check && bun run check:registry",
    "deploy:docs": "bun run build:docs && wrangler deploy",
    "boundary-check": "bun tooling/gates/boundary.ts",
    "contract-check": "bun tooling/gates/contract.ts",
    "coverage-check": "bun tooling/gates/coverage.ts",
    "a11y-coverage-check": "bun tooling/gates/a11y-coverage.ts",
    "generate:package": "bun tooling/package/generate.ts",
    "api-check": "bun tooling/package/api.ts",
    "api:snapshot": "bun tooling/package/api.ts --write",
    "test:package": "bun tooling/package/smoke.ts",
    "test:release": "bun tooling/package/release-smoke.ts",
    "generate:registry": "bun tooling/registry/generate.ts",
    "build:registry:v4": "bun tooling/registry/build.ts",
    "check:registry:v4": "bun tooling/registry/check.ts",
    "smoke:registry:v4": "bun tooling/registry/smoke.ts",
