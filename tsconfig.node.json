{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "allowImportingTsExtensions": true
  },
  "include": [
    "playwright.config.ts",
    "vite.config.ts",
    "vite.docs.config.ts",
    "registry/*.ts",
    "scripts",
    "tests/*.spec.ts",
    "tooling",
    "worker"
  ]
}
